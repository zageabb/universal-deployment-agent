{
  "lock_file": "/home/example/.local/state/deployment-agent/deploy.lock",
  "log_file": "/home/example/.local/state/deployment-agent/deploy.log",
  "state_file": "/home/example/.local/state/deployment-agent/status.json",
  "dashboard_token": "replace-with-a-long-random-password",
  "groups": ["Utilities"],
  "applications": [
    {
      "name": "example-app",
      "group": "Utilities",
      "enabled": true,
      "auto_deploy": false,
      "repo_path": "/home/example/apps/example-app",
      "branch": "main",
      "update_commands": [["./venv/bin/pip", "install", "-r", "requirements.txt"]],
      "restart_command": ["systemctl", "--user", "restart", "example-app.service"],
      "service_unit": "example-app.service",
      "health_url": "http://127.0.0.1:5055/health",
      "health_timeout": 30,
      "rollback": true,
      "scheduled_jobs": [
        {
          "name": "daily-maintenance",
          "description": "Run the application's daily maintenance",
          "enabled": true,
          "schedule": "daily",
          "time": "06:00",
          "command": ["./venv/bin/python", "manage.py", "maintenance"]
        }
      ]
    }
  ]
}
