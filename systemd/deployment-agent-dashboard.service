[Unit]
Description=Universal deployment agent dashboard
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/deployment-agent/venv/bin/python %h/.local/share/deployment-agent/dashboard.py --config %h/.config/deployment-agent/config.json --host 0.0.0.0 --port 5030
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
