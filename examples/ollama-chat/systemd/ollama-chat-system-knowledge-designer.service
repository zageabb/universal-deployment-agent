[Unit]
Description=Ollama Chat System Knowledge Designer
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ollama-chat/system-knowledge-designer
Environment=PATH=%h/ollama-chat/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/ollama-chat/system-knowledge-designer/start.sh
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
