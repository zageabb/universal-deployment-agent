[Unit]
Description=Ollama Chat System Knowledge Designer
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ollama-chat/system-knowledge-designer
Environment=PATH=%h/ollama-chat/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/ollama-chat/system-knowledge-designer.env
ExecStart=%h/ollama-chat/venv/bin/python %h/ollama-chat/system-knowledge-designer/app.py
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
