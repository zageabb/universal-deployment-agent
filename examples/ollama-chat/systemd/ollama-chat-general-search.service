[Unit]
Description=Ollama Chat General Search
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ollama-chat/general-search
Environment=PATH=%h/ollama-chat/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/ollama-chat/general-search/start.sh
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
