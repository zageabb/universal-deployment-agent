[Unit]
Description=Ollama Chat General Search
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ollama-chat/general-search
Environment=PATH=%h/ollama-chat/venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/ollama-chat/general-search.env
ExecStart=%h/ollama-chat/venv/bin/python %h/ollama-chat/general-search/app.py
Restart=on-failure
RestartSec=3
KillMode=control-group

[Install]
WantedBy=default.target
