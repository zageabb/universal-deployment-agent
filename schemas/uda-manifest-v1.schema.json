{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zageabb/Application-Standard/blob/main/standards/schemas/uda-manifest-v1.schema.json",
  "title": "UDA application repository manifest v1",
  "description": "Declarative onboarding metadata only. Never grants host execution or permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "runtime",
    "service"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "python",
            "node",
            "static"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
        },
        "working_dir": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "working_dir": {
          "$ref": "#/$defs/relativePath"
        },
        "commands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/argv"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "systemd",
            "static"
          ]
        },
        "entrypoint": {
          "$ref": "#/$defs/argv"
        },
        "port": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          ]
        },
        "health_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^/(?!/)[^?#\\r\\n]*$"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 8,
          "maxLength": 90,
          "pattern": "^/apps/[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?/$"
        },
        "authentication": {
          "const": "uda"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_update": {
          "type": "boolean"
        },
        "rollback": {
          "type": "boolean"
        },
        "github_reporting": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:\\.|[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*)$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "enum": [
                  "python",
                  "node"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "required": [
              "entrypoint"
            ],
            "properties": {
              "type": {
                "const": "systemd"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "const": "static"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "properties": {
              "type": {
                "const": "static"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proxy": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "proxy": {
            "properties": {
              "authentication": {
                "const": "uda"
              }
            }
          }
        }
      }
    }
  ]
}
